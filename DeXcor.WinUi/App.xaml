<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DeXcor.WinUi.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent Colors -->
            <Color x:Key="AccentColor">#F59E0B</Color>
            <Color x:Key="AccentColorLight">#FBBF24</Color>
            <Color x:Key="AccentColorDark">#D97706</Color>
            
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="AccentBrushLight" Color="{StaticResource AccentColorLight}" />
            <SolidColorBrush x:Key="AccentBrushDark" Color="{StaticResource AccentColorDark}" />

            <!-- Override system accent with our amber -->
            <SolidColorBrush x:Key="SystemAccentColor" Color="{StaticResource AccentColor}" />

            <!-- Card Styles -->
            <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
            <CornerRadius x:Key="ButtonCornerRadius">6</CornerRadius>
            <CornerRadius x:Key="ImageCornerRadius">8</CornerRadius>

            <Thickness x:Key="SmallMargin">4</Thickness>
            <Thickness x:Key="MediumMargin">8</Thickness>
            <Thickness x:Key="LargeMargin">16</Thickness>
            <Thickness x:Key="PageMargin">24</Thickness>

            <!-- Typography -->
            <x:Double x:Key="TitleFontSize">28</x:Double>
            <x:Double x:Key="SubtitleFontSize">20</x:Double>
            <x:Double x:Key="BodyFontSize">14</x:Double>
            <x:Double x:Key="CaptionFontSize">12</x:Double>

            <!-- Converters -->
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibility" xmlns:helpers="using:DeXcor.WinUi.Helpers"/>
            <helpers:BoolToVisibilityInverterConverter x:Key="BoolToVisibilityInverter" xmlns:helpers="using:DeXcor.WinUi.Helpers"/>
            <helpers:GreaterThanOneConverter x:Key="GreaterThanOneConverter" xmlns:helpers="using:DeXcor.WinUi.Helpers"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
