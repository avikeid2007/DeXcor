<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DeXcor.WinUi.Controls.QuickActionOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="OverlayRoot">
        <Grid.Resources>
            <Style TargetType="Button" x:Key="QuickActionButton">
                <Setter Property="Background" Value="#E0000000"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Width" Value="40"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="CornerRadius" Value="20"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </Grid.Resources>

        <!-- Semi-transparent gradient overlay -->
        <Border CornerRadius="8">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="0.4"/>
                    <GradientStop Color="#CC000000" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Quick action buttons at bottom -->
        <StackPanel 
            Orientation="Horizontal" 
            HorizontalAlignment="Center" 
            VerticalAlignment="Bottom"
            Margin="0,0,0,12"
            Spacing="12">
            
            <!-- Set Wallpaper -->
            <Button 
                x:Name="SetWallpaperButton"
                Click="SetWallpaper_Click"
                ToolTipService.ToolTip="Set as Wallpaper (W)"
                Style="{StaticResource QuickActionButton}">
                <FontIcon Glyph="&#xE8A9;" FontSize="16"/>
            </Button>
            
            <!-- Download -->
            <Button 
                x:Name="DownloadButton"
                Click="Download_Click"
                ToolTipService.ToolTip="Download (D)"
                Style="{StaticResource QuickActionButton}">
                <FontIcon Glyph="&#xE896;" FontSize="16"/>
            </Button>
            
            <!-- Open Detail -->
            <Button 
                x:Name="OpenDetailButton"
                Click="OpenDetail_Click"
                ToolTipService.ToolTip="View Details (Enter)"
                Style="{StaticResource QuickActionButton}">
                <FontIcon Glyph="&#xE8A3;" FontSize="16"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
