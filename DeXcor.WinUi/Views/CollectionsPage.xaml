<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeXcor.WinUi.Views.CollectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PexelsDotNetSDK.Models"
    NavigationCacheMode="Required">

    <Grid>
        <!-- Dark Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1a1a2e" Offset="0"/>
                <GradientStop Color="#16213e" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Padding="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,24">
                <FontIcon Glyph="&#xE734;" FontSize="32" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock 
                    Text="Featured Collections" 
                    FontSize="32" 
                    FontWeight="SemiBold"
                    Foreground="White"/>
            </StackPanel>

            <!-- Loading -->
            <ProgressRing 
                Grid.Row="1"
                x:Name="LoadingRing"
                Width="48" Height="48"
                IsActive="True"/>

            <!-- Collections Grid -->
            <GridView 
                Grid.Row="1"
                x:Name="CollectionsGrid"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="Collection_Click">

                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid MaximumRowsOrColumns="4" Orientation="Horizontal" ItemWidth="320" ItemHeight="240"/>
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>

                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Click="CollectionButton_Click"
                            Padding="0"
                            BorderThickness="0"
                            Background="#20FFFFFF"
                            CornerRadius="12"
                            Width="320"
                            Height="380"
                            Margin="12">
                            
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="280"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 2x2 Collage -->
                                <Grid Grid.Row="0" ColumnSpacing="2" RowSpacing="2" CornerRadius="12,12,0,0" Background="#111">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Image Grid.Row="0" Grid.Column="0" Source="{Binding Photo1Url}" Stretch="UniformToFill"/>
                                    <Image Grid.Row="0" Grid.Column="1" Source="{Binding Photo2Url}" Stretch="UniformToFill"/>
                                    <Image Grid.Row="1" Grid.Column="0" Source="{Binding Photo3Url}" Stretch="UniformToFill"/>
                                    <Image Grid.Row="1" Grid.Column="1" Source="{Binding Photo4Url}" Stretch="UniformToFill"/>
                                </Grid>

                                <!-- Text Content -->
                                <StackPanel Grid.Row="1" Padding="16" VerticalAlignment="Center" Spacing="4">
                                    <TextBlock 
                                        Text="{Binding Model.title}" 
                                        FontSize="18" 
                                        FontWeight="Bold" 
                                        Foreground="#F59E0B"
                                        TextTrimming="CharacterEllipsis"/>
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="8" Opacity="0.7">
                                        <Border Background="#30FFFFFF" CornerRadius="4" Padding="6,2">
                                            <TextBlock FontWeight="SemiBold" FontSize="12" Foreground="White">
                                                <Run Text="{Binding Model.photos_count}"/>
                                                <Run Text=" photos"/>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Text="by Pexels" VerticalAlignment="Center" FontSize="12" Foreground="#CCCCCC"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Load More Button -->
            <Button 
                Grid.Row="1"
                x:Name="LoadMoreButton"
                Content="Load More"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,24"
                Padding="24,12"
                CornerRadius="20"
                Click="LoadMore_Click"
                Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>

