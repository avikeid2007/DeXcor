<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DeXcor.WinUi.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:PexelsDotNetSDK.Models"
    xmlns:vm="using:DeXcor.WinUi.ViewModels"
    Background="Transparent"
    NavigationCacheMode="Required">

    <Grid>
        <!--  Background with Image Grid  -->
        <Grid>
            <!--  Background Grid  -->

            <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundWallpapers, Mode=OneWay}" Opacity="0.4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid
                            ItemHeight="150"
                            ItemWidth="200"
                            Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Photo">
                        <Image
                            Margin="2"
                            Opacity="0.6"
                            Source="{x:Bind source.medium}"
                            Stretch="UniformToFill" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Dark Overlay (Reduced Opacity for more acrylic visibility)  -->
            <Rectangle Fill="#701a1a2e" />
        </Grid>

        <!--  Main Content  -->
        <Grid>
            <!--  Surprise Me Button - Clean Golden Glow  -->
            <Border
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="32"
                BorderBrush="#D4A84B"
                BorderThickness="2"
                Background="#30281810"
                Padding="0"
                Translation="0,0,40">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                
                <Button
                    x:Name="SurpriseMeButton"
                    Padding="36,16"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{x:Bind ViewModel.SurpriseMeCommand}"
                    CornerRadius="30">

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            FontSize="20"
                            Foreground="#D4A84B"
                            Glyph="&#xE8B1;" />
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#D4A84B"
                            Text="Surprise Me!" />
                    </StackPanel>
                </Button>
            </Border>

            <!--  ...  -->

            <!--  Current Wallpaper Info (Bottom Center)  -->
            <Border
                MaxWidth="600"
                Margin="0,0,0,48"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Background="#90000000"
                CornerRadius="16"
                Visibility="{x:Bind ViewModel.HasSetWallpaper, Mode=OneWay}">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Thumbnail  -->
                    <Border
                        Width="80"
                        Height="50"
                        CornerRadius="8">
                        <Image Source="{x:Bind ViewModel.CurrentPhoto.source.medium, Mode=OneWay}" Stretch="UniformToFill" />
                    </Border>

                    <!--  Photographer Credit  -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="White"
                            Text="{x:Bind ViewModel.CurrentPhoto.photographer, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="12"
                            Foreground="White"
                            Opacity="0.7"
                            Text="on Pexels" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!--  Pexels Attribution  -->
        <StackPanel
            Margin="24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0.5"
            Orientation="Horizontal">

            <TextBlock VerticalAlignment="Center" Text="Powered by " />
            <TextBlock
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Text="Pexels" />
        </StackPanel>
    </Grid>
</Page>
