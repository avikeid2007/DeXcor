<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DeXcor.WinUi.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:DeXcor.WinUi.Services"
    NavigationCacheMode="Required">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon Glyph="&#xE896;" FontSize="28" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Downloads" FontSize="{StaticResource TitleFontSize}" FontWeight="SemiBold"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <TextBlock VerticalAlignment="Center" Opacity="0.7">
                    <Run x:Name="TotalCountText" Text="0"/>
                    <Run Text=" wallpapers downloaded"/>
                </TextBlock>
                <Button Content="Open Folder" Click="OpenFolder_Click"/>
            </StackPanel>
        </Grid>

        <!-- Active Downloads -->
        <StackPanel Grid.Row="1" Margin="0,24,0,16" Visibility="{x:Bind HasActiveDownloads, Mode=OneWay}">
            <TextBlock Text="Active Downloads" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>
            
            <ItemsControl x:Name="ActiveDownloadsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:DownloadItem">
                        <Border 
                            Background="#20FFFFFF" 
                            CornerRadius="8" 
                            Padding="12" 
                            Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Thumbnail -->
                                <Border CornerRadius="4" Width="50" Height="50">
                                    <Image Source="{x:Bind Photo.source.tiny}" Stretch="UniformToFill"/>
                                </Border>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Margin="12,0">
                                    <TextBlock Text="{x:Bind Photo.photographer}" FontWeight="SemiBold"/>
                                    <ProgressBar 
                                        Value="{x:Bind Progress, Mode=OneWay}" 
                                        Maximum="100" 
                                        Margin="0,8,0,4"/>
                                    <TextBlock Opacity="0.7" FontSize="12">
                                        <Run Text="{x:Bind DisplaySize}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{x:Bind Status}"/>
                                    </TextBlock>
                                </StackPanel>

                                <!-- Cancel -->
                                <Button Grid.Column="2" Content="✕" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Completed Downloads -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Download History" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"/>

            <GridView 
                Grid.Row="1"
                x:Name="CompletedDownloadsList"
                SelectionMode="None">

                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="services:DownloadItem">
                        <Grid Width="160" Height="120" CornerRadius="8">
                            <Image Source="{x:Bind Photo.source.small}" Stretch="UniformToFill"/>
                            
                            <Border VerticalAlignment="Bottom" Background="#80000000" Padding="8,4">
                                <StackPanel>
                                    <TextBlock 
                                        Text="{x:Bind Category}" 
                                        FontSize="11" 
                                        Opacity="0.8"
                                        Foreground="White"/>
                                    <TextBlock 
                                        Text="{x:Bind DisplaySize}" 
                                        FontSize="11" 
                                        Opacity="0.6"
                                        Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- Empty State -->
            <StackPanel 
                Grid.Row="1"
                x:Name="EmptyState"
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Visibility="Collapsed">
                <FontIcon Glyph="&#xE896;" FontSize="48" Opacity="0.3"/>
                <TextBlock Text="No downloads yet" Opacity="0.5" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
